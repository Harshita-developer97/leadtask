# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Get this from your Neon project dashboard. Use the "pooled" connection
# string for serverless/Vercel deployments.
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/leadflow?sslmode=require"

# ── Auth.js ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV="development"
